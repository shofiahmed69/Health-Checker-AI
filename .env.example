# =============================================================================
# HealthTrack - Shared env for PostgreSQL & Ollama (Docker or local)
# Copy this to .env and share with your team - works on any PC
# =============================================================================

# Database (used by docker-compose postgres + app DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthtrack
POSTGRES_PORT=5432
# Must match above: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthtrack?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Ollama AI (used by docker-compose ollama + app)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_PORT=11434

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
